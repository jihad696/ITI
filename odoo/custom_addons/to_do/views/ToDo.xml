<odoo>
    <record id="action_all_tickets" model="ir.actions.act_window">
        <field name="name">All Tickets</field>
        <field name="res_model">lr.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_my_tickets" model="ir.actions.act_window">
        <field name="name">My Tickets</field>
        <field name="res_model">lr.ticket</field>
        <field name="view_mode">form</field>
    </record>

    <record id="view_ticket_list" model="ir.ui.view">
        <field name="name">lr.ticket.list</field>
        <field name="model">lr.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="number"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_ticket_form" model="ir.ui.view">
        <field name="name">lr.ticket.form</field>
        <field name="model">lr.ticket</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="number"/>
                            <field name="tag"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="file"/>
                            <field name="assign_to"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_all_tickets"
              name="All Tickets"
              parent="menu_root_Tickets"
              action="action_all_tickets"/>

    <menuitem id="menu_my_tickets"
              name="My Tickets"
              parent="menu_root_Tickets"
              action="action_my_tickets"/>
</odoo>